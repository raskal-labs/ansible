flush ruleset

# Define network variables
define VAULT_NET = {{ networks['vlan-64'].cidr }}
define HEADSCALE_NET = {{ infra_services.headscale.mesh_subnet }}
define BREAKGLASS_VPN_NET = {{ infra_services.vpn.cidr }}

# ====================================================================
# CrowdSec — dedicated table for bouncer-managed ban sets
# The bouncer manages this table directly. Do not edit manually.
# ====================================================================
table inet crowdsec {
    set crowdsec-blacklists {
        type ipv4_addr
        flags timeout
    }

    chain crowdsec-chain {
        type filter hook input priority filter - 1; policy accept;
        ip saddr @crowdsec-blacklists drop
    }
}

table inet filter {
    chain input {
        type filter hook input priority filter; policy drop;

        # Allow internal loopback
        iifname "lo" accept

        # Allow returning internet traffic
        ct state established,related accept

        # Allow SSH from LAN and VPN networks
        iifname "{{ interfaces.lan.dev }}" tcp dport 22 accept
        iifname "wg0" tcp dport 22 accept

        # Allow DNS and DHCP from LAN
        iifname "{{ interfaces.lan.dev }}" udp dport { 53, 67 } accept
        iifname "{{ interfaces.lan.dev }}" tcp dport 53 accept

        # Allow ICMP (Ping)
        ip protocol icmp accept

        # Allow HTTP and HTTPS from WAN and LAN to router itself
        iifname "{{ interfaces.wan.dev }}" tcp dport { 80, 443 } accept
        iifname "{{ interfaces.lan.dev }}" tcp dport { 80, 443 } accept

        # Allow incoming VPN handshake on WAN
        iifname "{{ interfaces.wan.dev }}" udp dport {{ host_services.vpn.port | default(51820) }} accept

        # Allow Headscale DERP STUN traffic
        iifname "{{ interfaces.wan.dev }}" udp dport {{ infra_services.headscale.derp.port }} accept

        # Allow CrowdSec LAPI on loopback (bouncer -> LAPI)
        iifname "lo" tcp dport 8080 accept
    }

    chain forward {
        type filter hook forward priority filter; policy drop;

        # Allow returning internet traffic
        ct state established,related accept

        # Allow Vault network to route to WAN
        ip saddr $VAULT_NET oifname "{{ interfaces.wan.dev }}" accept

        # Allow Headscale mesh traffic
        ip saddr $HEADSCALE_NET ip daddr $VAULT_NET accept
        ip saddr $VAULT_NET ip daddr $HEADSCALE_NET accept

        # Allow Breakglass VPN to access Vault network
        ip saddr $BREAKGLASS_VPN_NET ip daddr $VAULT_NET accept
        ip saddr $VAULT_NET ip daddr $BREAKGLASS_VPN_NET accept

        # Allow VPN clients (wg0) to route traffic into networks
        iifname "wg0" oifname "{{ interfaces.lan.dev }}" accept
    }
}

table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;

        # Masquerade (NAT) all traffic leaving the WAN port
        oifname "{{ interfaces.wan.dev }}" masquerade
    }
}
