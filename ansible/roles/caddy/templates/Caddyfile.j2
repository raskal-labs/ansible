# Generated by Ansible - DO NOT EDIT MANUALLY
{
    email {{ infra_services.caddy.email | default('labs@raskal.io') }}
    log {
        output file /var/log/caddy/caddy-system.log {
            roll_size 10mb
            roll_keep 5
        }
        level INFO
    }
}

# ====================================================================
# --- TLS PROFILES ---
# ====================================================================
{% for name, profile in infra_services.caddy.tls_profiles.items() %}
({{ name }}) {
{% if profile.type == 'acme' %}
    tls {
        issuer acme {{ profile.endpoint }} {
            trusted_roots {{ profile.trusted_roots }}
        }
    }
{% endif %}
}
{% endfor %}

# ====================================================================
# --- AUTH PROFILES ---
# ====================================================================
{% for name, profile in infra_services.caddy.auth_profiles.items() %}
({{ name }}) {
    forward_auth 10.{{ profile.backend_network }}.0.{{ profile.backend_host }}:{{ profile.backend_port }} {
        uri {{ profile.uri }}
        copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
    }
}
{% endfor %}

# ====================================================================
# --- SERVICES ---
# ====================================================================
{% for svc in infra_services.caddy.services %}
{{ svc.domains | join(', ') }} {
    {% if svc.tls is defined %}
    import {{ svc.tls }}
    {% endif %}
    {% if svc.auth is defined %}
    import {{ svc.auth }}
    {% endif %}

    {% if svc.action | default('reverse_proxy') == 'respond' %}
    respond "{{ svc.response_msg }}" {{ svc.response_code }}

    {% elif svc.action | default('reverse_proxy') == 'redir' %}
    redir {{ svc.redir_target }} permanent

    {% elif svc.action | default('reverse_proxy') == 'headscale' %}
    handle /generate_204 {
        respond 204
    }
    handle * {
        reverse_proxy {{ svc.backend }} {
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
        }
    }

    {% elif svc.action | default('reverse_proxy') == 'doh_public' %}
    handle /dns-query* {
        reverse_proxy 10.{{ svc.backend_network }}.0.{{ svc.backend_host }}:{{ svc.backend_port }} {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle {
        respond "Access Denied: Dedicated Protocol Endpoint." 403
    }

    {% elif svc.action | default('reverse_proxy') == 'doh_internal' %}
    handle /dns-query {
        reverse_proxy 10.{{ svc.backend_network }}.0.{{ svc.backend_host }}:{{ svc.backend_port }} {
            header_up Host {host}
            header_up X-Real-IP {client_ip}
            header_up X-Forwarded-For {client_ip}
        }
    }
    handle /dns-query* {
        respond "Unauthorized" 401
    }

    {% else %}
    {# default reverse_proxy #}
    reverse_proxy {% if svc.tls_insecure_skip_verify | default(false) %}https://{% endif %}10.{{ svc.backend_network }}.0.{{ svc.backend_host }}:{{ svc.backend_port }} {
        {% if svc.tls_insecure_skip_verify | default(false) %}
        transport http {
            tls_insecure_skip_verify
        }
        {% endif %}
        {% if svc.header_up_host is defined %}
        header_up Host {{ svc.header_up_host }}
        {% endif %}
    }
    {% endif %}
}

{% endfor %}

# ====================================================================
# --- DEFAULT PORTAL ---
# ====================================================================
:80 {
    respond "[REDACTED]-labs" 200
}
