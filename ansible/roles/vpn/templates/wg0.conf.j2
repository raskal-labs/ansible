# Generated by Ansible - DO NOT EDIT MANUALLY
[Interface]
PrivateKey = {{ host_services.vpn.privkey }}
Address = {{ infra_services.vpn.prefix }}.{{ host_services.vpn.host_id }}/{{ infra_services.vpn.prefix_len }}
ListenPort = {{ host_services.vpn.port }}

{% for peer in host_services.vpn.peers %}
[Peer]
# {{ peer.name }}
PublicKey = {{ peer.pubkey }}
{% if peer.route_lan | default(false) %}
AllowedIPs = {{ infra_services.vpn.prefix }}.{{ peer.host_id }}/32, {{ networks['vlan-64'].cidr }}{% if peer.extra_ips is defined %}, {{ peer.extra_ips | join(', ') }}{% endif %}

{% else %}
AllowedIPs = {{ infra_services.vpn.prefix }}.{{ peer.host_id }}/32{% if peer.extra_ips is defined %}, {{ peer.extra_ips | join(', ') }}{% endif %}

{% endif %}
{% endfor %}
