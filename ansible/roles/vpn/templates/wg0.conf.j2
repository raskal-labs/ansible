# Generated by Ansible - DO NOT EDIT MANUALLY
[Interface]
PrivateKey = {{ host_services.vpn.privkey }}
Address = {{ subnets.vpn.prefix }}.{{ host_services.vpn.host_id }}/24
ListenPort = {{ host_services.vpn.port }}

{% for peer in host_services.vpn.peers %}
[Peer]
# {{ peer.name }}
PublicKey = {{ peer.pubkey }}
{% if peer.route_lan | default(false) %}
AllowedIPs = {{ subnets.vpn.prefix }}.{{ peer.host_id }}/32, {{ subnets.lan.cidr }}
{% else %}
AllowedIPs = {{ subnets.vpn.prefix }}.{{ peer.host_id }}/32
{% endif %}
{% endfor %}
